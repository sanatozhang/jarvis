# ========================================
# Jarvis Configuration
# ========================================

# --- Feishu API (required) ---
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=your_secret_here

# --- Slack 通知（2026-09 迁移中，按模块可切）---
# ⚠️ 这个 token 跟 Apollo 共用同一个 Slack app（Apollo Notify）。
#    轮换它会**同时打断两个产品**的通知——换的时候 Apollo 的 .env 也要改。
#    详见 DEPLOY.md 4.1 和
#    docs/superpowers/specs/2026-09-23-jarvis-slack-notify-design.md
# 只有把某个模块的 notify.provider 切成 slack 时才必须配。
SLACK_BOT_TOKEN=xoxb-xxx
# 各模块的频道 id（存 id 不存 name，改名不影响）。刻意没有默认值——
# 带默认值的渠道专属 id 会在切换时指向另一个渠道，发送方看起来成功、收件人是空气。
GRAYGATE_NOTIFY_PROVIDER=feishu
GRAYGATE_SLACK_CHANNEL=

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/jarvis.db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Code Repository (optional, for code-aware analysis) ---
CODE_REPO_PATH=

# --- Linear API (for @ai-agent triggered analysis) ---
LINEAR_API_KEY=lin_api_xxx
LINEAR_WEBHOOK_SECRET=your_webhook_secret_here
LINEAR_TRIGGER_KEYWORD=@ai-agent
LINEAR_TEAM_ID=

# --- Zendesk API (optional, for ticket import) ---
ZENDESK_SUBDOMAIN=nicebuildllc
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=

# --- OpenAI (optional, for Zendesk conversation summary) ---
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# --- AI Engine (optional, overrides config.yaml agent.default and all routing)
# Valid values: claude_code | codex
# AGENT_DEFAULT=claude_code

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
SECRET_KEY=change-me-to-a-random-string

# --- Ports (for docker-compose) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Crashguard
CRASHGUARD_DATADOG_API_KEY=
CRASHGUARD_DATADOG_APP_KEY=

# 三平台仓库路径（已存在的复用，新增的填上）
# CODE_REPO_APP=/path/to/plaud_ai
# CODE_REPO_IOS=/path/to/plaud_ios
# CODE_REPO_ANDROID=/path/to/plaud_android

# === Feishu SSO ===
ENABLE_SSO=false
SSO_FEISHU_APP_ID=
SSO_FEISHU_APP_SECRET=
SSO_FEISHU_REDIRECT_URI=https://apollo.nicebuild.click/api/auth/feishu/callback
SSO_JWT_SECRET=                              # openssl rand -hex 32
SSO_ALLOWED_DOMAINS=plaud.ai
SSO_COOKIE_NAME=jarvis_session
SSO_COOKIE_DAYS=365
SSO_COOKIE_SECURE=true
SSO_COOKIE_DOMAIN=
SSO_EXEMPT_PATHS=/api/health,/api/linear/webhook,/api/v1/,/api/auth/
ADMIN_EMAILS=
